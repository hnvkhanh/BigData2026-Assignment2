<mxfile host="app.diagrams.net"><diagram name="Build graph" id="build-graph"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1950"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bandA" value="Phase A: build the static graph once (Graph(&quot;chain&quot;))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="-130" y="-9" width="1100" height="28" as="geometry"/></mxCell><mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="35" width="200" height="40" as="geometry"/></mxCell><mxCell id="p1" value="Load the 8 tables: Users, Repositories, PullRequests, Issues, IssueComments, PRReviews, PRReviewComments, Pushes. Node id = table offset + row index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="95" width="380" height="80" as="geometry"/></mxCell><mxCell id="p2" value="Per node: table type, row time (days since data start, missing = inf), standardised features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="205" width="380" height="70" as="geometry"/></mxCell><mxCell id="p3" value="For each table and each FK column (col -&gt; referenced table)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="210" y="305" width="380" height="50" as="geometry"/></mxCell><mxCell id="p4" value="Make edges: row node -&gt; referenced node, relation id = (table, col)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="385" width="380" height="50" as="geometry"/></mxCell><mxCell id="d1" value="Is col the actor FK? (author / reviewer / user)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="450" width="260" height="100" as="geometry"/></mxCell><mxCell id="pk" value="Keep the FK edge as is. If col = repo_id: repo[row] = repository node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="460" width="240" height="80" as="geometry"/></mxCell><mxCell id="p5" value="actor[row] = user node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="-50" y="475" width="220" height="50" as="geometry"/></mxCell><mxCell id="d2" value="structure == chain?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="-50" y="545" width="220" height="90" as="geometry"/></mxCell><mxCell id="p6" value="Sort the table's rows by (actor, time). Link each row to the same actor's next row of that table (earlier -&gt; later, relation CHAIN_REL). The actor FK edge is dropped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="-65" y="635" width="250" height="130" as="geometry"/></mxCell><mxCell id="p7" value="Keep the actor FK as a normal edge (plain FK graph)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="615" width="200" height="70" as="geometry"/></mxCell><mxCell id="d3" value="More FK columns / tables?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="755" width="260" height="90" as="geometry"/></mxCell><mxCell id="p8" value="Concatenate the edges. Build CSR adjacency: forward FK edges (fptr, fadj, frel) and undirected edges both ways (ptr, adj)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="875" width="380" height="70" as="geometry"/></mxCell><mxCell id="p9" value="Index each user's activity rows by table, then time (aptr, aadj): finds the latest visible row of a chain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="975" width="380" height="60" as="geometry"/></mxCell><mxCell id="bandB" value="Phase B: build the graph of one example (user, week cut-off) = K tokens" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="-130" y="1061" width="1100" height="28" as="geometry"/></mxCell><mxCell id="p10" value="visible = row time &lt; its table's cut-off (optional lookback window, exclude pushes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="1110" width="380" height="60" as="geometry"/></mxCell><mxCell id="p11" value="Seeds (hop 0): the user's num_seeds latest visible actions, from any table, newest first. The user becomes a hop-1 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="1190" width="380" height="80" as="geometry"/></mxCell><mxCell id="p12" value="Hop 1: the latest visible row of each chain that is not a seed. Then expand the frontier over adj: keep visible rows, cap each node's neighbours (newest first), drop tokens already taken" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="380" height="100" as="geometry"/></mxCell><mxCell id="p13" value="Order candidates newest first (fk_order = recent). Take them while the budget K fits (a row that brings a new user costs 2). Owners of other users' rows join as tokens; the walk does not continue from other users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="1405" width="380" height="90" as="geometry"/></mxCell><mxCell id="d4" value="Budget K full, max_hops reached or frontier empty?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="250" y="1510" width="300" height="100" as="geometry"/></mxCell><mxCell id="p14" value="If short of K: repeat random tokens. If nothing reachable: random visible rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="1640" width="380" height="60" as="geometry"/></mxCell><mxCell id="p15" value="Edges among the K tokens: FK edges; chain edges (same actor, same table, in time order); a row of another user -&gt; its user; a row of the example's user -&gt; the user only if it is its chain's latest visible row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="190" y="1720" width="420" height="90" as="geometry"/></mxCell><mxCell id="end" value="Graph of the example (tokens + edges) goes to RelGT" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="1840" width="260" height="40" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="start" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p4" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="pk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d1" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p5" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="p6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="p7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6" target="d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="800"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p7" target="d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="760"/><mxPoint x="400" y="760"/></Array></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="pk" target="d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="800"/></Array></mxGeometry></mxCell><mxCell id="e14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d3" target="p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="800"/><mxPoint x="980" y="330"/></Array></mxGeometry></mxCell><mxCell id="e15" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="p8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p8" target="p9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p9" target="p10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p10" target="p11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p11" target="p12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p12" target="p13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p13" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d4" target="p12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1560"/><mxPoint x="900" y="1340"/></Array></mxGeometry></mxCell><mxCell id="e23" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d4" target="p14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p14" target="p15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p15" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>